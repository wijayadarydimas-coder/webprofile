# ==============================================================================
# WIJAYA DARY DIMAS PERSONAL DIGITAL HUB — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env.local untuk konfigurasi lokal Anda:
#   Windows (PowerShell) : Copy-Item .env.example .env.local
#   Linux / macOS        : cp .env.example .env.local
# 
# PENTING: JANGAN PERNAH COMMIT file .env.local ATAU KUNCI RAHASIA KE DALAM GIT!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. URL DOMAIN SITUS (NEXT_PUBLIC_SITE_URL)
# ------------------------------------------------------------------------------
# Fungsi: Digunakan untuk canonical URL SEO, Open Graph preview media sosial, dan sitemap.
# - Saat di komputer lokal (laptop / dev) : "http://localhost:3000"
# - Saat dideploy di Vercel               : "https://nama-project-anda.vercel.app" (atau domain kustom)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ------------------------------------------------------------------------------
# 2. AUTENTIKASI & KEAMANAN SESI (AUTH_SECRET)
# ------------------------------------------------------------------------------
# Fungsi: Kunci rahasia untuk menandatangani (sign) dan memverifikasi JWT session cookie HttpOnly.
# Digunakan untuk:
#   1. Keamanan Login Admin (/admin/login)
#   2. Keamanan Login Pengunjung di Forum Diskusi Komunitas (/community)
# Syarat: String acak yang panjang dan aman (minimal 32 karakter).
# Cara buat di terminal (opsional): openssl rand -base64 32
AUTH_SECRET="wijayadarydimas-super-secure-production-secret-token-2026-min-32-chars"

# Akun Administrator Awal (Dipakai untuk login pertama kali ke /admin/login)
ADMIN_EMAIL="admin@wijayadarydimas.dev"
ADMIN_PASSWORD="GantiDenganPasswordSuperAman2026!"
ADMIN_NAME="Wijaya Dary Dimas"

# ------------------------------------------------------------------------------
# 3. BASIS DATA (POSTGRESQL / SUPABASE)
# ------------------------------------------------------------------------------
# Aplikasi ini mendukung dua cara pengisian database:
#
# OPSI A (Disarankan): Connection String URI Lengkap
# Dapatkan di Supabase Dashboard:
#   Buka Project Settings > Database > Connection string > Tab "URI"
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Contoh:
DATABASE_URL="postgresql://postgres:password_database_anda@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# OPSI B: Parameter Terpisah dari Supabase (Connection Pooling / Direct Connection)
# Jika dashboard Supabase Anda menampilkan parameter terpisah, script migrasi kami
# (scripts/db-setup.mjs & scripts/create-admin.mjs) otomatis membaca variabel ini:
host="aws-0-ap-southeast-1.pooler.supabase.com"
port="6543"
database="postgres"
user="postgres.xxxxxx"
password="password_database_anda"

# ------------------------------------------------------------------------------
# 4. SUPABASE API KEYS & REST CLIENT (OPSIONAL)
# ------------------------------------------------------------------------------
# Dapatkan di Supabase Dashboard > Project Settings > API
# SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL: URL proyek Supabase
SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY: Kunci anon publik
SUPABASE_PUBLISHABLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# SUPABASE_JWKS_URL: Endpoint verifikasi JSON Web Key Set (jika memakai external auth)
SUPABASE_JWKS_URL="https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json"

# SUPABASE_SERVICE_ROLE_KEY: Kunci rahasia backend (Hanya server-side, JANGAN pernah ke publik)
SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"

# ------------------------------------------------------------------------------
# 5. ASISTEN AI (GOOGLE GEMINI / OPENAI)
# ------------------------------------------------------------------------------
# Penyedia AI yang dipilih: "gemini" (disarankan) atau "openai"
AI_PROVIDER="gemini"

# API Key Google Gemini (Gratis di https://aistudio.google.com/)
# Sistem menerima salah satu dari AI_API_KEY atau GEMINI_API_KEY:
AI_API_KEY=""
GEMINI_API_KEY=""

# Model Gemini yang digunakan (Sistem menerima AI_MODEL atau GEMINI_MODEL):
# Pilihan populer:
#   - gemini-3.5-flash-lite (Sangat cepat dan hemat kuota)
#   - gemini-1.5-flash      (Seimbang, responsif)
#   - gemini-2.0-flash      (Generasi terbaru)
GEMINI_MODEL="gemini-3.5-flash-lite"
AI_MODEL="gemini-3.5-flash-lite"

# Custom Base URL (Hanya jika memakai OpenAI atau self-hosted model proxy):
# AI_API_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------------------------
# 6. PENYIMPANAN BERKAS & MEDIA (STORAGE)
# ------------------------------------------------------------------------------
# Default berkas tersimpan secara lokal di direktori public/uploads/
# Jika menghubungkan Supabase Storage bucket:
STORAGE_BUCKET="media"
